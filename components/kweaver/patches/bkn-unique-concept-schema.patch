+// Licensed under the Apache License, Version 2.0.
+
+package interfaces
+
+import "testing"
+
+func TestGetBKNConceptSchemaDefinitionHasUniqueFieldNames(t *testing.T) {
+	for _, smallModelEnabled := range []bool{false, true} {
+		fieldNames := make(map[string]struct{})
+		displayNames := make(map[string]struct{})
+		for _, property := range GetBKNConceptSchemaDefinition(1024, smallModelEnabled) {
+			if _, exists := fieldNames[property.Name]; exists {
+				t.Fatalf(
+					"duplicate field name %q when default small model enabled is %t",
+					property.Name,
+					smallModelEnabled,
+				)
+			}
+			fieldNames[property.Name] = struct{}{}
+
+			displayName := property.DisplayName
+			if displayName == "" {
+				displayName = property.Name
+			}
+			if _, exists := displayNames[displayName]; exists {
+				t.Fatalf(
+					"duplicate field display name %q when default small model enabled is %t",
+					displayName,
+					smallModelEnabled,
+				)
+			}
+			displayNames[displayName] = struct{}{}
+		}
+	}
+}
